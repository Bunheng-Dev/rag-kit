# REQUIRED
# Internal API key used by POST /api/v1/chat/stream.
CHAT_INTERNAL_KEY=replace-with-a-long-random-value
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Qdrant cloud: https://your-cluster-id.region.cloud.qdrant.io
# Docker selfhost: http://qdrant:6333
# Local Python: http://localhost:6333
QDRANT_URL=https://your-qdrant-cluster.example
QDRANT_API_KEY=replace-with-your-qdrant-api-key

# OPTIONAL
# Application
APP_NAME=rag-kit
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
# Optional API version prefix
API_V1_PREFIX=/api/v1
DEBUG=false
ENABLE_CARDS=false
RETRIEVAL_TOP_K=6
CARD_MAX_ITEMS=5
CORS_ALLOW_ORIGINS=*

# Ingestion data safety: block, redact, or disable scanning.
SECRET_SCAN_MODE=block
SECRET_SCAN_BLOCKED_COLUMNS=password,passwd,secret,token,api_key,private_key
# Optional additional regexes, one per line.
SECRET_SCAN_ALLOWLIST=

# Provider selection
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
VECTOR_DB=qdrant
DATASOURCE=file
SAMPLE_DATA_PATH=data/sample.json

# Gemini LLM and embeddings
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RESPONSE_LANGUAGE=auto

# Qdrant collection settings
QDRANT_COLLECTION=rag_documents
QDRANT_TIMEOUT=120

# MySQL: only needed when DATASOURCE=mysql.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=rag_kit
MYSQL_CONNECT_TIMEOUT=5
MYSQL_DOCUMENT_TABLE=documents
MYSQL_DOCUMENT_ID_COLUMN=id
MYSQL_DOCUMENT_TEXT_COLUMN=text
MYSQL_DOCUMENT_METADATA_COLUMNS=

# Prompt and optional card/media URL configuration
PROMPT_TEMPLATE_PATH=prompts/system.txt
PROMPT_TEMPLATE=
MEDIA_BASE_URL=
CARD_URL_TEMPLATE={base_url}/items/{slug}?id={id}

# Optional Cloudflare tunnel for the cloud profile; never commit the real value.
CLOUDFLARE_TOKEN=
